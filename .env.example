# Non-secret settings only. Secrets live in chmod-600 files (see README), never in env.
PANTA_MODE=test                 # test = Panta sandbox fixtures + Solana devnet (default). live = mainnet.
# POT_ALLOW_LIVE_WRITES=1       # required (with PANTA_MODE=live) before any real-money write is allowed
POT_PUBLIC_URL=http://localhost:3100
# SOLANA_RPC_URL=               # defaults: devnet in test mode, mainnet-beta in live mode
# POT_DB_PATH=./data/pot.db
