# Non-secret settings only. Never put secrets in this file or commit them.
# Secrets (Panta keys, bot token, HMAC/webhook secrets) are read from chmod-600 files in ~/.panta and ~/.pot locally,
# or from Vercel sensitive env vars (POT_PANTA_TEST_KEY, POT_TELEGRAM_TOKEN, ...) when hosted. See README "Secrets".
PANTA_MODE=test                 # test = practice mode (free signed messages, no transactions, no money). live = mainnet (see GO-LIVE.md)
# POT_ALLOW_LIVE_WRITES=1       # second lock: required with PANTA_MODE=live before any real-money write
POT_PUBLIC_URL=http://localhost:3100
# SOLANA_RPC_URL=               # live mode: a private mainnet RPC (defaults to the public mainnet-beta RPC)
# POT_DEFAULT_IMAGE_URL=        # live mode: market image (defaults to <POT_PUBLIC_URL>/market-default.png)
# POT_DB_PATH=./data/pot.db     # local SQLite when DATABASE_URL is unset

# Optional, practice mode: read-only Panta key so /panta and the home page show real live markets.
# GET-only (packages/server/src/livepanta.ts). Not the live-write key; POT_ALLOW_LIVE_WRITES stays unset.
# PANTA_READ_KEY=
